<?xml version="1.0" encoding="utf-8"?>
<!-- Tooltip that appears when tapping a data point on the chart.
     Shows exact time and rainfall rate at the tapped intersection. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_pill"
    android:elevation="6dp"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Time (e.g. "09:29 AM") -->
    <TextView
        android:id="@+id/textMarkerTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface" />

    <!-- Rate (e.g. "8.38 mm/hr") -->
    <TextView
        android:id="@+id/textMarkerRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/on_surface_secondary" />

</LinearLayout>
