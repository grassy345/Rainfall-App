<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen graph layout hosted by GraphActivity.
     Chart inside a rounded card with floating controls overlaid. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:padding="12dp">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- CHART CONTAINER — rounded card with subtle border           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardChart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surface_card"
        app:strokeWidth="1dp"
        app:strokeColor="@color/chart_grid">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Chart -->
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/chartFullscreen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <!-- No Data Overlay -->
            <TextView
                android:id="@+id/textNoData"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="No data for this date"
                android:textSize="18sp"
                android:textColor="@color/on_surface_secondary" />

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- TOP BAR: Mode Spinner + Date Nav + Switch + Close           -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_floating_pill"
        android:elevation="8dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <!-- Mode Spinner -->
        <Spinner
            android:id="@+id/spinnerMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/on_surface" />

        <!-- Spacer — pushes everything after it to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Jump to Today (hidden when viewing today) -->
        <TextView
            android:id="@+id/chipToday"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="↩ Jump to Today"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- ← Previous date -->
        <ImageButton
            android:id="@+id/btnPrevDate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_left"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Previous date"
            app:tint="@color/on_surface" />

        <!-- Date label -->
        <TextView
            android:id="@+id/textDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            tools:text="Today" />

        <!-- → Next date -->
        <ImageButton
            android:id="@+id/btnNextDate"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_chevron_right"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Next date"
            app:tint="@color/on_surface" />

        <!-- Separator dot -->
        <View
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/connection_dot"
            android:backgroundTint="@color/chart_label" />

        <!-- Calendar picker -->
        <ImageButton
            android:id="@+id/btnCalendar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_calendar"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:contentDescription="Pick date"
            app:tint="@color/on_surface" />

        <!-- Separator dot -->
        <View
            android:layout_width="3dp"
            android:layout_height="3dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/connection_dot"
            android:backgroundTint="@color/chart_label" />

        <!-- Switch to Readings -->
        <TextView
            android:id="@+id/btnSwitchReadings"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Readings"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Close -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Close"
            app:tint="@color/on_surface_secondary" />

    </LinearLayout>

</FrameLayout>
